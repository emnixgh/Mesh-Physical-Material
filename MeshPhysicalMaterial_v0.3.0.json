    {
      "description": "",
      "fullName": "Mesh physical material",
      "name": "MeshPhysicalMaterial",
      "objectType": "Scene3D::Model3DObject",
      "eventsFunctions": [
        {
          "description": "Mesh physical material",
          "fullName": "Mesh physical material",
          "functionType": "Action",
          "group": "Mesh physical material",
          "name": "MeshPhysicalMaterial",
          "sentence": "Apply to _PARAM0_ a physical material with color _PARAM2_, albedo map _PARAM3_, normal map _PARAM4_, ambient occlusion map _PARAM5_, bump map _PARAM6_, specular map _PARAM7_, anisotropy map _PARAM8_, emmisive map _PARAM9_, displacement map _PARAM10_, alpha map _PARAM11_, roughness map _PARAM12_, metallnes map _PARAM13_, Iridescence map _PARAM14_, light map _PARAM15_, transmission map _PARAM16_, roughness _PARAM17_, metallnes _PARAM18_, IOR _PARAM19_, specular intensity _PARAM20_, iridescence _PARAM21_, iridescence IOR _PARAM22_, reflectivity _PARAM23_, flat shading _PARAM24_, wireframe _PARAM25_, texture wrap X _PARAM26_, texture wrap Y _PARAM27_, texture offset Y _PARAM28_, texture offset X _PARAM29_, reflection type _PARAM30_, quality _PARAM31_, reflection intensity _PARAM32_, refresh rate of reflections _PARAM33_, reflections far clipping distance _PARAM34_, anisotropy filtering _PARAM35_, blending _PARAM36_, opacity _PARAM37_, render side _PARAM38_,  update every frame _PARAM39_, material slot _PARAM40_",
          "events": [
            {
              "type": "BuiltinCommonInstructions::JsCode",
              "inlineCode": [
                "const updateeveryframe = eventsFunctionContext.getArgument(\"Update\");",
                "",
                "objects.forEach((object) => {",
                "",
                "    const ThreeObject = object.get3DRendererObject();",
                "    if (!ThreeObject) return;",
                "",
                "    const Scene = runtimeScene.getLayer(\"Base Layer\").getRenderer().getThreeScene();",
                "    const Renderer = runtimeScene.getGame().getRenderer().getThreeRenderer();",
                "    ",
                "",
                "    const Res = eventsFunctionContext.getArgument(\"Res\") || 256;",
                "    const MaterialSlot = eventsFunctionContext.getArgument(\"MaterialSlot\");",
                "    const RefType = eventsFunctionContext.getArgument(\"RefType\");",
                "    const RefUpdate = eventsFunctionContext.getArgument(\"RefUpdate\") || 0.1;",
                "    const FarPlane = eventsFunctionContext.getArgument(\"FarPlane\") || 2500;",
                "    const RefInt = eventsFunctionContext.getArgument(\"RefInt\") || 1;",
                "    const Opacity = eventsFunctionContext.getArgument(\"Opacity\") || 1;",
                "",
                "    const RenderSideArg = eventsFunctionContext.getArgument(\"RenderSide\");",
                "    const BlendingArg = eventsFunctionContext.getArgument(\"Blending\");",
                "",
                "    let BlendingMode = THREE.NormalBlending;",
                "",
                "    switch (BlendingArg) {",
                "",
                "        case \"Additive\":",
                "            BlendingMode = THREE.AdditiveBlending;",
                "            break;",
                "",
                "        case \"Subtractive\":",
                "            BlendingMode = THREE.SubtractiveBlending;",
                "            break;",
                "",
                "        case \"Multiply\":",
                "            BlendingMode = THREE.MultiplyBlending;",
                "            break;",
                "",
                "        default:",
                "            BlendingMode = THREE.NormalBlending;",
                "",
                "    }",
                "",
                "    let RenderSideMode = THREE.FrontSide;",
                "",
                "    switch (RenderSideArg) {",
                "",
                "        case \"Back side\":",
                "            RenderSideMode = THREE.BackSide;",
                "            break;",
                "",
                "        case \"Double side\":",
                "            RenderSideMode = THREE.DoubleSide;",
                "            break;",
                "",
                "        default:",
                "            RenderSideMode = THREE.FrontSide;",
                "",
                "    }",
                "",
                "    if (!ThreeObject.__reflectionData) {",
                "",
                "        const CubeRenderTarget = new THREE.WebGLCubeRenderTarget(Res, {",
                "            format: THREE.RGBAFormat,",
                "            generateMipmaps: true,",
                "            minFilter: THREE.LinearMipmapLinearFilter,",
                "            magFilter: THREE.LinearFilter",
                "        });",
                "",
                "        CubeRenderTarget.texture.mapping = THREE.CubeReflectionMapping;",
                "        CubeRenderTarget.texture.type = THREE.HalfFloatType;",
                "",
                "        const CubeCamera = new THREE.CubeCamera(1, FarPlane, CubeRenderTarget);",
                "",
                "        CubeCamera.layers.enableAll();",
                "        CubeCamera.scale.set(1, -1, 1);",
                "",
                "        Scene.add(CubeCamera);",
                "",
                "        ThreeObject.__reflectionData = {",
                "            CubeCamera,",
                "            CubeRenderTarget,",
                "            Renderer,",
                "            Scene,",
                "            Materials: {},",
                "            LastUpdate: 0",
                "        };",
                "",
                "    }",
                "",
                "    const data = ThreeObject.__reflectionData;",
                "",
                "    const TextureLoader = new THREE.TextureLoader();",
                "",
                "    const WrapS = eventsFunctionContext.getArgument(\"WrapS\");",
                "    const WrapT = eventsFunctionContext.getArgument(\"WrapT\");",
                "    const XOffset = eventsFunctionContext.getArgument(\"Xoff\");",
                "    const YOffset = eventsFunctionContext.getArgument(\"Yoff\");",
                "    const Anisotropy = eventsFunctionContext.getArgument(\"Filter\");",
                "",
                "    function loadTexture(path) {",
                "",
                "        if (!path) return null;",
                "",
                "        const texture = TextureLoader.load(path);",
                "",
                "        texture.wrapS = THREE.RepeatWrapping;",
                "        texture.wrapT = THREE.RepeatWrapping;",
                "",
                "        texture.repeat.set(WrapS, WrapT);",
                "        texture.offset.set(XOffset, YOffset);",
                "",
                "        texture.anisotropy = Anisotropy;",
                "",
                "        return texture;",
                "",
                "    }",
                "",
                "    let material = data.Materials[MaterialSlot];",
                "",
                "    if (!material) {",
                "",
                "        material = new THREE.MeshPhysicalMaterial({",
                "",
                "            wireframe: eventsFunctionContext.getArgument(\"Wireframe\"),",
                "            flatShading: eventsFunctionContext.getArgument(\"FlatShading\"),",
                "",
                "            color: new THREE.Color(",
                "                gdjs.rgbOrHexStringToNumber(",
                "                    eventsFunctionContext.getArgument(\"Color\")",
                "                )",
                "            ),",
                "",
                "            side: RenderSideMode,",
                "            blending: BlendingMode,",
                "",
                "            opacity: Opacity,",
                "            transparent: Opacity < 1,",
                "",
                "            map: loadTexture(eventsFunctionContext.getArgument(\"Map\")),",
                "            aoMap: loadTexture(eventsFunctionContext.getArgument(\"AOMap\")),",
                "            normalMap: loadTexture(eventsFunctionContext.getArgument(\"NormalMap\")),",
                "            displacementMap: loadTexture(eventsFunctionContext.getArgument(\"DisplacementMap\")),",
                "            alphaMap: loadTexture(eventsFunctionContext.getArgument(\"AlphaMap\")),",
                "            emissiveMap: loadTexture(eventsFunctionContext.getArgument(\"EmissiveMap\")),",
                "            bumpMap: loadTexture(eventsFunctionContext.getArgument(\"BumpMap\")),",
                "            anisotropyMap: loadTexture(eventsFunctionContext.getArgument(\"AnisotropyMap\")),",
                "            specularColorMap: loadTexture(eventsFunctionContext.getArgument(\"SpecularMap\")),",
                "            roughnessMap: loadTexture(eventsFunctionContext.getArgument(\"RoughnessMap\")),",
                "            metalnessMap: loadTexture(eventsFunctionContext.getArgument(\"MetalnessMap\")),",
                "            iridescenceMap: loadTexture(eventsFunctionContext.getArgument(\"IridescenceMap\")),",
                "            lightMap: loadTexture(eventsFunctionContext.getArgument(\"LightMap\")),",
                "            transmissionMap: loadTexture(eventsFunctionContext.getArgument(\"TransmissionMap\")),",
                "",
                "            roughness: eventsFunctionContext.getArgument(\"Roughness\"),",
                "            metalness: eventsFunctionContext.getArgument(\"Metalness\"),",
                "            ior: eventsFunctionContext.getArgument(\"IOR\"),",
                "            reflectivity: eventsFunctionContext.getArgument(\"Reflectivity\"),",
                "",
                "            envMapIntensity: RefInt",
                "",
                "        });",
                "",
                "        if (RefType === \"Dynamic cubemap\") {",
                "            material.envMap = data.CubeRenderTarget.texture;",
                "        }",
                "",
                "        let slotIndex = 0;",
                "",
                "        ThreeObject.traverse((node) => {",
                "",
                "            if (!node.isMesh) return;",
                "            if (!node.material) return;",
                "",
                "            if (node.material.isMaterial) {",
                "",
                "                if (MaterialSlot === -1 || slotIndex === MaterialSlot) {",
                "",
                "                    node.material = material;",
                "                    data.Materials[MaterialSlot] = material;",
                "",
                "                }",
                "",
                "                slotIndex++;",
                "",
                "            }",
                "",
                "        });",
                "",
                "    }",
                "",
                "    if (updateeveryframe && material) {",
                "",
                "        material.wireframe = eventsFunctionContext.getArgument(\"Wireframe\");",
                "        material.flatShading = eventsFunctionContext.getArgument(\"FlatShading\");",
                "",
                "        material.color.set(",
                "            gdjs.rgbOrHexStringToNumber(",
                "                eventsFunctionContext.getArgument(\"Color\")",
                "            )",
                "        );",
                "",
                "        material.side = RenderSideMode;",
                "        material.blending = BlendingMode;",
                "",
                "        material.opacity = Opacity;",
                "        material.transparent = Opacity < 1;",
                "",
                "        material.roughness = eventsFunctionContext.getArgument(\"Roughness\");",
                "        material.metalness = eventsFunctionContext.getArgument(\"Metalness\");",
                "        material.ior = eventsFunctionContext.getArgument(\"IOR\");",
                "        material.reflectivity = eventsFunctionContext.getArgument(\"Reflectivity\");",
                "",
                "        material.envMapIntensity = RefInt;",
                "",
                "        material.needsUpdate = true;",
                "",
                "    }",
                "",
                "    const isDynamic = RefType === \"Dynamic cubemap\";",
                "",
                "    if (isDynamic) {",
                "",
                "        const now = performance.now() / 1000;",
                "",
                "        if (RefUpdate === 0 || now - data.LastUpdate >= RefUpdate) {",
                "",
                "            data.LastUpdate = now;",
                "",
                "            ThreeObject.visible = false;",
                "",
                "            data.CubeCamera.position.copy(ThreeObject.position);",
                "",
                "            const currentAutoClear = data.Renderer.autoClear;",
                "",
                "            data.Renderer.autoClear = true;",
                "",
                "            data.CubeCamera.update(data.Renderer, data.Scene);",
                "",
                "            data.Renderer.autoClear = currentAutoClear;",
                "",
                "            ThreeObject.visible = true;",
                "",
                "        }",
                "",
                "    }",
                "",
                "});"
              ],
              "parameterObjects": "Object",
              "useStrict": true,
              "eventsSheetExpanded": true
            }
          ],
